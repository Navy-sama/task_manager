<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug-build only: allows plain HTTP to the local backend addresses
         declared in network_security_config.xml (this file's res/xml
         override, not the one under src/main). Merged into the main
         <application> element by the manifest merger. -->
    <application android:networkSecurityConfig="@xml/network_security_config"/>
</manifest>
