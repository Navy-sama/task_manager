# Copy to backend/.env for local runs (./mvnw spring-boot:run). Never commit the real file.

# Matches the MySQL service of the root docker-compose.yml.
DATABASE_URL=jdbc:mysql://localhost:3306/taskmanager
DATABASE_USERNAME=taskmanager
DATABASE_PASSWORD=change-me

# Base64-encoded HMAC key, at least 32 bytes. Generate with: openssl rand -base64 32
JWT_SECRET=

# Comma-separated list. Leave empty when the web app is served from the same origin (default).
CORS_ALLOWED_ORIGINS=
