# Copy to .env at the repository root; read by docker-compose.yml. Never commit the real file.
MYSQL_DATABASE=taskmanager
MYSQL_USER=taskmanager
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
MYSQL_PORT=3306

# Compose `app` profile only (backend + frontend), see docs/deployment.md
JWT_SECRET=
BACKEND_PORT=8081
FRONTEND_PORT=8080
